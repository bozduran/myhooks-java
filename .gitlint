# Commit-message rules for this repository.
#
# Enforced by the `gitlint` pre-commit hook on the commit-msg stage (see
# .pre-commit-config.yaml). This replaces the old Java `commitmsg` step, which
# enforced a Conventional Commit subject and reported LanguageTool
# spelling/grammar issues.

[general]
# Enable gitlint's Conventional Commits rule (CT1).
contrib=contrib-title-conventional-commits

# The removed `commitmsg` step validated the subject only, so keep subject-only
# commits valid and short bodies allowed; gitlint otherwise requires a body and
# a body of at least 20 characters.
ignore=body-is-missing,body-min-length

[contrib-title-conventional-commits]
# The commit types the removed `commitmsg` step accepted.
types=feat,fix,docs,style,refactor,perf,test,build,ci,chore,revert

[title-max-length]
line-length=72

[body-max-line-length]
line-length=100

# A "no double spaces" check: gitlint has no built-in rule for repeated spaces,
# so two named rule instances reject it in the subject and in the body.
# Trailing whitespace and hard tabs are already covered by the default rules
# title-trailing-whitespace (T2), body-trailing-whitespace (B2),
# title-hard-tab (T4) and body-hard-tab (B3), so they need no configuration.
[title-match-regex:no-double-space]
regex=^(?!.*  )

[body-match-regex:no-double-space]
regex=(?s)\A(?!.*  )
